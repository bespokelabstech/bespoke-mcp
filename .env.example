# Copy to .env.local for local development. NEVER commit real values.
# Names are identical in every deployment (tenant x environment); only values differ.

# Which tenant config (src/tenants/<id>) and which environment overlay to load.
MCP_TENANT=gla
MCP_ENV=staging

# Shared key Claude sends in the `x-api-key` request header. >= 32 chars.
# Generate: openssl rand -base64 32
MCP_ACCESS_KEY=
# Optional second key accepted during rotation.
MCP_ACCESS_KEY_NEXT=

# Moodle REST web services (restricted, read-only service account token).
# Leave empty to run with Moodle "not configured" (tools return a config error).
MOODLE_BASE_URL=
MOODLE_WS_TOKEN=
# Optional, default 15000.
MOODLE_TIMEOUT_MS=

# Local development only: serve synthetic data instead of calling Moodle.
# Refused on Vercel. Values: fixture
MCP_DATA_SOURCE=

# Optional: debug | info | warn | error (default info)
LOG_LEVEL=
